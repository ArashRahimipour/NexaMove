# Copy this file to .env (local dev) and configure real values in your hosting
# provider's environment-variable settings for staging/production.

# --- Database (required) ---
# Local dev (docker compose): postgresql://nexamove:nexamove@localhost:5432/nexamove
# Managed Postgres (Neon/Supabase/Railway/Render): use the connection string they give you.
DATABASE_URL="postgresql://nexamove:nexamove@localhost:5432/nexamove"

# --- Auth (required) ---
# Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Full public URL of the deployed app, e.g. https://app.nexamove.com.au
NEXTAUTH_URL="http://localhost:3000"

# --- File storage (optional) ---
# If unset, photos/signatures are saved to ./private-uploads (fine for a
# single instance / early testing, but NOT durable across redeploys on most
# hosts). Either way, files are private — only viewable through the app's
# own authorised routes (app/api/files/*), never a directly public URL.
# Set these to use S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2)
# — the bucket should be PRIVATE (no public-read policy); the app generates
# short-lived signed URLs on demand for authorised viewers only:
# S3_BUCKET="nexamove-pod"
# S3_REGION="ap-southeast-2"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""               # only needed for R2/B2/non-AWS

# --- AI Assistant (optional) ---
# Without this, NexaMove AI (Operations AI + customer Delivery Assistant)
# shows "temporarily unavailable" and every other NexaMove feature works
# normally. Get a key at https://platform.openai.com — never prefix this
# with NEXT_PUBLIC_, it must stay server-side only.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Monitoring / error logging (optional but recommended for production) ---
# Create a free project at https://sentry.io and paste its DSN here.
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# Only needed if you want source maps uploaded on build (nicer stack traces):
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
# Set to "staging" on your staging deployment to separate it from production in Sentry:
# SENTRY_ENVIRONMENT=""
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
