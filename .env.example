# Copy this file to .env (local dev) and configure real values in your hosting
# provider's environment-variable settings for staging/production.

# --- Database (required) ---
# Local dev (docker compose): postgresql://nexamove:nexamove@localhost:5432/nexamove
# Managed Postgres (Neon/Supabase/Railway/Render): use the connection string they give you.
# On Supabase specifically, if this is the pooled "Transaction pooler"
# string (port 6543), append "?pgbouncer=true" to the end of it — without
# that, Prisma's server-side prepared statements collide across PgBouncer's
# shared backend connections and queries fail with Postgres error 42P05
# ("duplicate prepared statement"). Not needed for a direct/unpooled
# connection like the local one below.
DATABASE_URL="postgresql://nexamove:nexamove@localhost:5432/nexamove"

# --- DIRECT_URL (required only if DATABASE_URL is a pooled/pgbouncer
# connection, e.g. Supabase's port-6543 "Transaction pooler" string) ---
# `prisma migrate` needs a direct, non-pooled connection — pgbouncer's
# transaction-pooling mode doesn't support the session-level locks the
# migration engine uses. On Supabase, use the "Direct connection" string
# (port 5432) here; DATABASE_URL stays the pooled one the running app
# actually queries through. Not needed at all for a plain, unpooled
# Postgres like the local docker-compose one above — leave unset.
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# --- Auth (required) ---
# Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Full public URL of the deployed app, e.g. https://app.nexamove.com.au
NEXTAUTH_URL="http://localhost:3000"

# --- File storage (optional) ---
# If unset, photos/signatures are saved to ./private-uploads (fine for a
# single instance / early testing, but NOT durable across redeploys on most
# hosts). Either way, files are private — only viewable through the app's
# own authorised routes (app/api/files/*), never a directly public URL.
# Set these to use S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2)
# — the bucket should be PRIVATE (no public-read policy); the app generates
# short-lived signed URLs on demand for authorised viewers only:
# S3_BUCKET="nexamove-pod"
# S3_REGION="ap-southeast-2"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""               # only needed for R2/B2/non-AWS

# --- Google Maps (optional) ---
# Without this, the customer tracking page still shows a plain-text ETA
# window (from the driver's live GPS position, already tracked regardless
# of this key) but no embedded map. With it, a live map renders showing
# the driver's current position and the destination. Needs the "Maps
# JavaScript API" enabled on the key. Public by design (NEXT_PUBLIC_ —
# it's used client-side to load the map), so restrict it to your domain in
# the Google Cloud Console rather than relying on secrecy.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Customer notifications: SMS (optional) ---
# Without these, tracking-link / delivery-confirmation / delivery-failed
# SMS messages are simply not sent — every attempt is still recorded on
# NotificationLog with status NOT_CONFIGURED, and the underlying delivery
# workflow (route start, POD, failure) is never blocked by this. Get these
# from https://www.twilio.com/console — TWILIO_FROM_NUMBER must be a
# number/sender you've provisioned in that Twilio account.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# --- Customer notifications: email (optional) ---
# Same graceful degradation as SMS above. Get an API key at
# https://resend.com and verify NOTIFICATIONS_FROM_EMAIL's domain there
# before sending will work.
# RESEND_API_KEY=""
# NOTIFICATIONS_FROM_EMAIL="NexaMove <notifications@yourdomain.com.au>"

# --- AI Assistant (optional) ---
# Without this, NexaMove AI (Operations AI + customer Delivery Assistant)
# shows "temporarily unavailable" and every other NexaMove feature works
# normally. Get a key at https://platform.openai.com — never prefix this
# with NEXT_PUBLIC_, it must stay server-side only.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Monitoring / error logging (optional but recommended for production) ---
# Create a free project at https://sentry.io and paste its DSN here.
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# Only needed if you want source maps uploaded on build (nicer stack traces):
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
# Set to "staging" on your staging deployment to separate it from production in Sentry:
# SENTRY_ENVIRONMENT=""
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
