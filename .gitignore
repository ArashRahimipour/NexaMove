node_modules/
.next/
out/
build/
dist/

# lockfile intentionally not committed — `npm install` resolves fresh
# against package.json's semver ranges on every install (see Dockerfile)
package-lock.json

# env
.env
.env.local
.env.*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os
.DS_Store

# uploads (local dev storage - never commit real customer photos/signatures)
# private-uploads/ is the current location (outside public/, served only
# through the authorised app/api/files/* routes); public/uploads/ is kept
# ignored too since it's where files from before that change may still sit.
private-uploads/
public/uploads/*
!public/uploads/.gitkeep

# prisma
prisma/dev.db

# typescript
*.tsbuildinfo
next-env.d.ts

# sentry
.sentryclirc
